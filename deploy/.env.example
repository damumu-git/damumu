# Public URL with no trailing slash. Use the static IP for initial HTTP testing,
# then replace it with the final HTTPS domain and rebuild web/admin.
PUBLIC_ORIGIN=http://203.0.113.10

# PostgreSQL runs on the Lightsail host. Access is limited to the fixed Compose
# subnet by pg_hba.conf and UFW, so it is never exposed on the public firewall.
DATABASE_CONNECTION=Host=host.docker.internal;Port=5432;Database=damumu;Username=damumu_app;Password=replace-me;SSL Mode=Disable

# Generate separately; do not reuse these values.
AUTH_TOKEN_KEY=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-separate-random-secret

# Optional FCM server configuration. Push remains disabled when omitted.
FIREBASE_PROJECT_ID=
