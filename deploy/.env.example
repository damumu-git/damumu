# Public URL with no trailing slash. Use the static IP for initial HTTP testing,
# then replace it with the final HTTPS domain and rebuild web/admin.
PUBLIC_ORIGIN=http://203.0.113.10

# PostgreSQL connection string. Production should require TLS.
DATABASE_CONNECTION=Host=db.example.internal;Port=5432;Database=damumu;Username=damumu_app;Password=replace-me;SSL Mode=Require;Trust Server Certificate=false

# Generate separately; do not reuse these values.
AUTH_TOKEN_KEY=replace-with-at-least-32-random-characters
ADMIN_API_KEY=replace-with-a-separate-random-secret

# Optional FCM server/client configuration. Push remains disabled when omitted.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_VAPID_KEY=
